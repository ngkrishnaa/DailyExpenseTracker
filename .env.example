# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=daily_expense_tracker

# Flask Configuration
FLASK_SECRET_KEY=generate-a-long-random-secret-key

# Email Configuration (Resend API is recommended for production)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ExpenseFlow <onboarding@resend.dev>

# Optional SMTP Fallback
MAIL_EMAIL=your-email@example.com
MAIL_PASSWORD=your-smtp-app-password

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://dailyexpensetracker-production-bf76.up.railway.app/login/google/callback
